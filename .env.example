# ─── NEXUS Trading — environment template ────────────────────────────────────
# Copy this file to `.env.local` and fill in your own values.
# `.env.local` is gitignored and excluded from Docker images. Never commit keys.
#
# ZERO COST: NEXUS never spends money. It runs with NO keys at all, on public
# keyless sources (Yahoo Finance, SEC EDGAR, FRED, Nasdaq, NSE, CBOE, RSS). Every key below is
# OPTIONAL, is a free tier that needs no payment method, and cannot bill you.
# Pay-per-use providers are not supported and a CI test blocks adding them.
#
# Do NOT set NODE_ENV here. Next.js sets it itself (development for `next dev`,
# production for `next build` / `next start`); overriding it causes subtle bugs.


# ═══ Market data (all optional, all free, no card) ══════════════════════════
FINNHUB_API_KEY=          # finnhub.io — TTM ratios in Stock Profile, extra news (profile works without it)
NEWS_API_KEY=             # newsapi.org — extra news coverage (100 req/day)
ALPHA_VANTAGE_KEY=        # alphavantage.co — news sentiment


# ═══ AI (optional, free, no card) ════════════════════════════════════════════
# Without this, commentary is written by built-in deterministic rules and the
# news feed simply has no AI line. Groq's free tier stops serving at its rate
# limit; it never bills.
GROQ_API_KEY=             # console.groq.com
# GROQ_MODEL=openai/gpt-oss-20b   # override if Groq retires the default model


# ═══ Upstash Redis (optional) ════════════════════════════════════════════════
# Shares caches and rate limits across server instances. Without it both are
# per-process, which is correct for a single Docker container / `next start`.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=


# ═══ API protection ══════════════════════════════════════════════════════════
# Requests per minute, per client IP, across all /api routes (default 600) and
# for the expensive routes individually (default 120).
# RATE_LIMIT_PER_MIN=600
# RATE_LIMIT_HEAVY_PER_MIN=120

# Set to 1 (with Upstash configured) to enforce rate limits across instances.
# Recommended on serverless hosts (Vercel, Amplify). Adds one Redis call per request.
# RATE_LIMIT_DISTRIBUTED=1

# How many trusted reverse proxies sit in front of the app (default 1).
# This decides which X-Forwarded-For entry is treated as the client address.
# Wrong value = rate limits that are either bypassable or shared by everyone.
# TRUSTED_PROXY_HOPS=1

# Other websites are blocked from calling this deployment's API from a browser.
# To allow specific origins, list them comma-separated.
# NEXUS_ALLOWED_ORIGINS=https://example.com


# ═══ Branding ════════════════════════════════════════════════════════════════
NEXT_PUBLIC_APP_NAME=NEXUS
# Anything prefixed NEXT_PUBLIC_ is shipped to every browser.
# NEVER put a key or secret in a NEXT_PUBLIC_ variable.
